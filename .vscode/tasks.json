{
    "version": "2.0.0",
    "windows": {
        "options": {
            "shell": {
                "executable": "cmd.exe",
                "args": ["/d", "/c"]
            }
        }
    },
    "tasks": [
        {
            "type": "shell",
            "label": "start openocd",
            "command": "${env:WCH_OPENOCD}/openocd.exe -f ${env:WCH_OPENOCD}/wch-dual-core.cfg -c noload",
            "args":[],

            "isBackground": true,
            "problemMatcher": {
                "pattern": {
                  "regexp": "Error:",
                  "file": 1,
                  "location": 1,
                  "severity": 4
                },
                "background": {
                  "activeOnStart": true,
                  "beginsPattern": "Open On-Chip Debugger 0.11.0+dev-snapshot",
                  "endsPattern": "Info : Listening on port 4444 for telnet connections"
                }
            }
        },
        {
            "type": "shell",
            "label": "flash openocd",
            "command": "${env:WCH_OPENOCD}/openocd.exe -f ${input:workspaceFolderForvardSlash}/debug_files/wch-dual-core-vscode.cfg -c \"program ${input:workspaceFolderForvardSlash}/build/debug/V5F/cmake_ch32h417_v5f.hex verify reset exit\"",
            "args":[],

            "isBackground": false,
            "problemMatcher": {
                "pattern": {
                  "regexp": "Error:",
                  "file": 1,
                  "location": 1,
                  "severity": 4
                },
                "background": {
                  "activeOnStart": true,
                  "beginsPattern": "Open On-Chip Debugger 0.11.0+dev-snapshot",
                  "endsPattern": "Info : Listening on port 3334 for gdb connections"
                }
            }
        },
    ],
    "inputs": [
    {
      "id": "workspaceFolderForvardSlash",
      "type": "command",
      "command": "extension.commandvariable.transform",
      "args": {
        "text": "${workspaceFolder}",
        "find": "\\\\",
        "replace": "/",
        "flags": "g"
      }
    }
  ]
}
