{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Build & Debug Microcontroller - WCH-Link",
            "cwd": "${workspaceFolder}",
            "executable": "${workspaceFolder}/build/debug/V3F/cmake_ch32h417_v3f.elf",
            // "loadFiles": ["C:/MounRiver/ch32h417/cmake_ch32h417_test/build/debug/V3F/cmake_ch32h417_v3f.hex"],
            "request": "launch",
            "type": "cortex-debug",
            "showDevDebugOutput": "parsed",
            // "runToEntryPoint": "main",
            // "numberOfProcessors": 2,
            // "targetProcessor": 0,
            // "chainedConfigurations": {
            //     "enabled": true,
            //     "waitOnEvent": "postInit",
            //     "detached": false,                         // Set this to true for JLink/STLink, false for most other type servers
            //     "lifecycleManagedByParent": true,
            //     "launches": [                              // Array of launches. Order is respected
            //         {
            //             "name": "Attach to Second Core - WCH-Link",     // Name of another configuration
            //             "folder": ""
            //         }
            //     ],
            // },
            "servertype": "openocd",
            "configFiles": [
                // "${env:WCH_OPENOCD}/wch-riscv.cfg"
                "${env:WCH_OPENOCD}/wch-dual-core-vscode.cfg"
            ],
            // "openOCDLaunchCommands": [],
            "openOCDLaunchCommands": [
                "chip_id CH32H417",
                "noload",
                "init",
                "wch_riscv unfreeze"
            ],
            "overrideLaunchCommands": [
                "set mem inaccessible-by-default off",
                "set architecture riscv:rv32",
                "set remotetimeout unlimited",
                "set disassembler-options xw"
            ],
            // "preLaunchCommands": [
            //     "load C:/MounRiver/ch32h417/cmake_ch32h417_test/build/debug/V3F/cmake_ch32h417_v3f.hex"
            // ],
            // "preRestartCommands": [],
            

            "svdFile": "${workspaceFolder}/CH32H417xx.svd",
        },
        {
            "name": "Attach to Second Core - WCH-Link",
            "cwd": "${workspaceFolder}",
            "type": "cortex-debug",
            "request": "attach",
            "executable": "${workspaceFolder}/build/debug/V5F/cmake_ch32h417_v5f.elf",

            "numberOfProcessors": 2,
            "targetProcessor": 1,
            "servertype": "external",
            "gdbTarget": "localhost:50005",
            "svdFile": "${workspaceFolder}/CH32H417xx.svd",
        }
    ]
}